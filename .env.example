# ----------- OpenRouter (LLM gateway used by all three containers) -----------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://github.com/anna-geiser/mas-deeptech-research
OPENROUTER_APP_TITLE=mas-deeptech-research (BSc thesis)

# Default model = free NVIDIA Nemotron 3 Super, with a free Llama fallback.
# System A reads MASF_MODEL_*; System B reads HRM_MODEL_* and falls back to MASF_* if unset.
# Reports container reads RPT_MODEL_* and falls back to MASF_*.
MASF_MODEL_MAIN=nvidia/nemotron-3-super-120b-a12b:free
MASF_MODEL_FALLBACK=meta-llama/llama-3.3-70b-instruct:free
# HRM_MODEL_MAIN=
# HRM_MODEL_FALLBACK=
# RPT_MODEL_MAIN=
# RPT_MODEL_FALLBACK=

# ----------- Supabase (shared signal database) -----------
# From the Supabase project dashboard → Project Settings → API.
# Use the SERVICE ROLE key (not the anon key) — all containers need to write or read.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ----------- Per-run knobs -----------
# System A — daily scrape sweeps the full actor list (40). Override to a smaller
# number for cost control during the thesis evaluation window.
MASF_LIMIT_ACTORS=40
# v0.4.0 wider funnel: 10 per collector × 4 collectors = ~40 raw candidates/actor.
# Strict Critic (drops on actor-relevance / quantum-relevance / dimension-evidence
# match) cuts most before persistence. Tune down if rate-limited.
MASF_LIMIT_ARXIV=10
MASF_LIMIT_WEBSITE=5
MASF_LIMIT_NEWS=10
MASF_LIMIT_PRESS=10
MASF_LIMIT_PATENTS=10

# System B — same. 40 actors x ~6 iterations is the slowest leg of the day.
HRM_LIMIT_ACTORS=40
HRM_MAX_ITERATIONS=6

# ----------- pgvector embeddings (optional, off by default) -----------
# Populate signals.embedding (vector(768), BAAI/bge-base-en-v1.5) on insert.
# Adds ~290MB on first cold start (ONNX runtime + model) and ~50ms / signal.
# Per-system gates so cron operators can A/B one system at a time.
# MASF_EMBEDDINGS=1
# HRM_EMBEDDINGS=1

# ----------- Semantic dedup via pgvector cosine (optional, off by default) -----------
# Requires the corresponding *_EMBEDDINGS=1 — without a query embedding,
# there's nothing to compare. Before insert, each signal is checked against
# the corpus (same actor, last N days) via the find_similar_signals RPC;
# if cosine similarity >= threshold, the signal is dropped + logged to the
# audit folder (System A) or transcript (System B).
# MASF_SEMANTIC_DEDUP=1
# MASF_SEMANTIC_DEDUP_THRESHOLD=0.92  # 0.5..0.999 inclusive
# MASF_SEMANTIC_DEDUP_DAYS=90          # 1..365 inclusive — v0.4.0 default
# HRM_SEMANTIC_DEDUP=1
# HRM_SEMANTIC_DEDUP_THRESHOLD=0.92
# HRM_SEMANTIC_DEDUP_DAYS=90

# ----------- Critic consensus (System A only, off by default) -----------
# Number of independent Critic passes per actor; majority vote determines
# kept signals (self-consistency, Wang et al. 2023). Default 1 = current
# behaviour. Set to 3 for self-consistency critic. Triples Critic LLM cost
# (Critic is ~10-15% of run total), kept off until evaluation needs it.
# MASF_CRITIC_CONSENSUS_PASSES=3

# ----------- Critic debate (System A only, off by default) -----------
# Number of debate rounds AFTER the consensus passes (Du et al. 2023
# multi-agent debate). Requires MASF_CRITIC_CONSENSUS_PASSES=3 as a
# prerequisite — debating requires prior verdicts to debate over.
# Default 0 = no debate. Set to 1 to enable one debate round (only R=1
# implemented; larger values silently clamp to 1). DOUBLES the consensus
# Critic cost (6x baseline single-pass). Turn on for evaluation runs
# that compare classification quality across the three modes.
# MASF_CRITIC_DEBATE_ROUNDS=1

# ----------- EPO Open Patent Services (off by default — fills source_kind='swissreg') -----------
# Both systems will query the EPO OPS API for quantum-relevant patents
# naming each actor as applicant. If either var is unset, the patent
# collector silently returns [] (no regression). Free tier (4 GB/week).
# Register at https://developers.epo.org → create an app → copy the
# Consumer Key + Secret. Same credentials work for both containers.
# EPO_OPS_CONSUMER_KEY=
# EPO_OPS_CONSUMER_SECRET=

# ----------- Optional (other tools referenced by the thesis) -----------
GEMINI_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=
# TELEGRAM_BOT_TOKEN=   # uncomment to wire the optional Telegram gateway (System B)
