# Caddy reverse proxy for the BSc-thesis site.
#
# Automatic HTTPS via Let's Encrypt for the domain below. Caddy obtains and
# renews the certificate with zero config beyond this file.
#
# Routing (new FastAPI + Next.js stack):
#   /api/*  → api  (FastAPI JSON service, container `api-container-f`)
#   /*      → web  (Next.js frontend,     container `web-container-g`)
#
# Authentication (v0.4.4; fixed v0.4.15):
#   The whole site is behind basic auth. v0.4.4 placed `basicauth` at site
#   level alongside `handle` blocks — but in Caddy 2.x, `handle` creates an
#   EXCLUSIVE subroute that doesn't inherit site-level auth, so the gate
#   never fired. v0.4.15 switches to a single `route` block that executes
#   directives in order — basicauth runs first, then the path-matched
#   reverse_proxy calls. Verified with `curl -I` returning 401.

mas-deeptech-research.cloud {
    encode gzip

    @api path /api/*

    # `route` executes directives in declared order, unlike top-level
    # directives which auto-order. basicauth fires FIRST and gates
    # every request before any reverse_proxy is reached.
    route {
        basicauth {
            # username  bcrypt-hash
            # PLACEHOLDER below — generate a real hash on the VPS:
            #   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext "your-password"
            # Paste the resulting $2a$14$... string in place of the placeholder
            # and `docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile`.
            anna $2a$14$PLACEHOLDER_HASH_REPLACE_BEFORE_DEPLOY___________________
        }
        reverse_proxy @api api-container-f:8000
        reverse_proxy web-container-g:3000
    }
}

www.mas-deeptech-research.cloud {
    redir https://mas-deeptech-research.cloud{uri} permanent
}
