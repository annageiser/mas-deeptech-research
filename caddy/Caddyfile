# Caddy reverse proxy for the BSc-thesis site.
#
# Automatic HTTPS via Let's Encrypt for the domain below. Caddy obtains and
# renews the certificate with zero config beyond this file.
#
# Routing (new FastAPI + Next.js stack):
#   /api/*  → api  (FastAPI JSON service, container `api-container-f`)
#   /*      → web  (Next.js frontend,     container `web-container-g`)
#
# Authentication (added v0.4.4, task #97):
#   Whole site behind basic auth — the data here is a public-domain research
#   project but we want the supervisor + ASA / FHNW audience to see a gate
#   that signals "this is a thesis artefact, not a production product."
#
#   Credentials default to user="anna", password="change-me". Rotate before
#   exposing the domain — see docs/reproducibility.md § "Site auth (basic)"
#   for the one-liner that generates a fresh bcrypt hash.

mas-deeptech-research.cloud {
    encode gzip

    # Site-wide basic auth — applied to every route, including /api/*.
    # If you need /api/* unauthenticated (e.g. so an external evaluator can
    # hit it without credentials), move the `basicauth` directive INSIDE
    # the `handle` block you want to gate, not at the site level.
    basicauth {
        # username  bcrypt-hash
        # Default placeholder: user="anna", password="change-me" (bcrypt cost 14).
        # Generate a real hash on the VPS:
        #   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext "your-password"
        # Then replace the line below and `docker compose restart caddy`.
        anna $2a$14$tQM5/HRGSm6t8.h7wmAYuQpv76Q0Zo9P7gE1zR2dG8nVxXnPpFx4u
    }

    handle /api/* {
        reverse_proxy api-container-f:8000
    }

    handle {
        reverse_proxy web-container-g:3000
    }
}

www.mas-deeptech-research.cloud {
    redir https://mas-deeptech-research.cloud{uri} permanent
}
