# ----------- OpenRouter (LLM gateway used by all three containers) -----------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=https://github.com/anna-geiser/mas-deeptech-research
OPENROUTER_APP_TITLE=mas-deeptech-research (BSc thesis)

# v0.4.36 — model unification across System A and System B.
#
# Both systems now default to the SAME model so the architecture comparison
# is not confounded by model-class differences. The model has four hard
# constraints (per the v0.4.30→v0.4.35 free-tier failure chain documented
# in systems/hermes/scripts/collect_all_actors.sh):
#   1. Free (price = 0)
#   2. NOT a reasoning model — Hermes's response parser cannot unwrap
#      <think> tokens, so reasoning models (Nemotron Super 120B,
#      openai/gpt-oss-120b) produce signals: [] for System B regardless
#      of how many real search hits the agent collected.
#   3. Tool-calling supported on at least one free provider.
#   4. Not rate-limited into oblivion (Llama-3.3-70B :free is).
#
# qwen/qwen3-next-80b-a3b-instruct:free satisfies all four (verified
# 2026-06-23). 80B-class capability close to the original Nemotron 120B
# while remaining parseable by Hermes.
#
# Containers:
#   - System A reads MASF_MODEL_*
#   - System B reads HERMES_MODEL (NOT HRM_MODEL_MAIN — script convention)
#   - Reports container reads RPT_MODEL_* and falls back to MASF_*
#
# To run both systems on different models (e.g. give System A a paid
# 120B for higher classification quality), override here per system.
# When doing so, document the asymmetry in §4.1.4 of the thesis.
MASF_MODEL_MAIN=qwen/qwen3-next-80b-a3b-instruct:free
MASF_MODEL_FALLBACK=meta-llama/llama-3.3-70b-instruct:free
HERMES_MODEL=qwen/qwen3-next-80b-a3b-instruct:free
# RPT_MODEL_MAIN=
# RPT_MODEL_FALLBACK=

# ----------- Supabase (shared signal database) -----------
# From the Supabase project dashboard → Project Settings → API.
# Use the SERVICE ROLE key (not the anon key) — all containers need to write or read.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ----------- Hermes (System B) web-search backend -----------
# Required for System B's web_search + web_extract tools. Without ANY of these,
# the agent registers the `web` toolset but each tool fails its availability
# check, ends up with `Tools: 0`, and every actor returns 0 signals (the agent
# correctly refuses to fabricate — quality rule #1 in the skill).
#
# Upstream priority: parallel → tavily → exa → brave-free → ddgs.
# Provision AT LEAST ONE. Tavily is recommended for free-tier setups — covers
# BOTH search and extract on a single key, 1,000 credits/month free, ~enough
# for weekly cron over 40 actors with ~6 searches each.
#
# Tavily — https://app.tavily.com/sign-in  →  Researcher (free) plan  →  API key
TAVILY_API_KEY=

# Alternates (any one is sufficient — see docs/reproducibility.md § "Hermes web tools").
# v0.4.14 also baked `ddgs` (DuckDuckGo Search) into the Hermes image as a
# free, no-API-key, unlimited fallback — so leaving ALL of these blank is
# perfectly fine and is the Anna-preferred free-only mode.
# EXA_API_KEY=             # https://exa.ai                    1k/mo free, search+extract
# BRAVE_SEARCH_API_KEY=    # https://api.search.brave.com      2k/mo free, search-only
# PARALLEL_API_KEY=        # https://parallel.ai               paid
#
# v0.4.19: Firecrawl removed from .env.example to enforce the free-only
# policy. Anna's first deploy used Firecrawl's 500/mo free tier; after
# depletion the agent fell back to ddgs (DuckDuckGo, unlimited free)
# which is now the recommended default. If you want Firecrawl back, set
# FIRECRAWL_API_KEY in your actual .env (not committed).

# ----------- Hermes (System B) cron knobs -----------
# Override the per-cron-run budget without rebuilding the image:
#   HERMES_LIMIT_ACTORS=3 HERMES_LOOKBACK_DAYS=60 docker compose run --rm hermes
# Default (unset) processes all 40 actors with a 180-day lookback window.
# HERMES_LIMIT_ACTORS=
# HERMES_LOOKBACK_DAYS=180

# ----------- Per-run knobs -----------
# System A — daily scrape sweeps the full actor list (40). Override to a smaller
# number for cost control during the thesis evaluation window.
MASF_LIMIT_ACTORS=40
# v0.4.0 wider funnel: 10 per collector × 4 collectors = ~40 raw candidates/actor.
# Strict Critic (drops on actor-relevance / quantum-relevance / dimension-evidence
# match) cuts most before persistence. Tune down if rate-limited.
MASF_LIMIT_ARXIV=10
MASF_LIMIT_WEBSITE=5
MASF_LIMIT_NEWS=10
MASF_LIMIT_PRESS=10
MASF_LIMIT_PATENTS=10

# System B — same. 40 actors x ~6 iterations is the slowest leg of the day.
HRM_LIMIT_ACTORS=40
HRM_MAX_ITERATIONS=6

# ----------- pgvector embeddings (optional, off by default) -----------
# Populate signals.embedding (vector(768), BAAI/bge-base-en-v1.5) on insert.
# Adds ~290MB on first cold start (ONNX runtime + model) and ~50ms / signal.
# Per-system gates so cron operators can A/B one system at a time.
# MASF_EMBEDDINGS=1
# HRM_EMBEDDINGS=1

# ----------- Semantic dedup via pgvector cosine (optional, off by default) -----------
# Requires the corresponding *_EMBEDDINGS=1 — without a query embedding,
# there's nothing to compare. Before insert, each signal is checked against
# the corpus (same actor, last N days) via the find_similar_signals RPC;
# if cosine similarity >= threshold, the signal is dropped + logged to the
# audit folder (System A) or transcript (System B).
# MASF_SEMANTIC_DEDUP=1
# MASF_SEMANTIC_DEDUP_THRESHOLD=0.92  # 0.5..0.999 inclusive
# MASF_SEMANTIC_DEDUP_DAYS=90          # 1..365 inclusive — v0.4.0 default
# HRM_SEMANTIC_DEDUP=1
# HRM_SEMANTIC_DEDUP_THRESHOLD=0.92
# HRM_SEMANTIC_DEDUP_DAYS=90

# ----------- Critic consensus (System A only, off by default) -----------
# Number of independent Critic passes per actor; majority vote determines
# kept signals (self-consistency, Wang et al. 2023). Default 1 = current
# behaviour. Set to 3 for self-consistency critic. Triples Critic LLM cost
# (Critic is ~10-15% of run total), kept off until evaluation needs it.
# MASF_CRITIC_CONSENSUS_PASSES=3

# ----------- Critic debate (System A only, off by default) -----------
# Number of debate rounds AFTER the consensus passes (Du et al. 2023
# multi-agent debate). Requires MASF_CRITIC_CONSENSUS_PASSES=3 as a
# prerequisite — debating requires prior verdicts to debate over.
# Default 0 = no debate. Set to 1 to enable one debate round (only R=1
# implemented; larger values silently clamp to 1). DOUBLES the consensus
# Critic cost (6x baseline single-pass). Turn on for evaluation runs
# that compare classification quality across the three modes.
# MASF_CRITIC_DEBATE_ROUNDS=1

# ----------- EPO Open Patent Services (off by default — fills source_kind='swissreg') -----------
# Both systems will query the EPO OPS API for quantum-relevant patents
# naming each actor as applicant. If either var is unset, the patent
# collector silently returns [] (no regression). Free tier (4 GB/week).
# Register at https://developers.epo.org → create an app → copy the
# Consumer Key + Secret. Same credentials work for both containers.
# EPO_OPS_CONSUMER_KEY=
# EPO_OPS_CONSUMER_SECRET=

# ----------- Phoenix observability (System A, off by default) -----------
# Replayable LLM-call traces in a local Phoenix server (Arize). Adds a small
# per-call overhead and requires the `phoenix` compose service to be up
# (`docker compose up -d phoenix`). UI on http://localhost:6006 — exposed
# only to the VPS host (SSH-tunnel to view). See docs/iterations/v0.4.25-...
# PHOENIX_ENABLED=1
# PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006/v1/traces  # /v1/traces is REQUIRED
# PHOENIX_PROJECT_NAME=masfactory-swiss-quantum

# ----------- Optional (other tools referenced by the thesis) -----------
GEMINI_API_KEY=
TAVILY_API_KEY=
# TELEGRAM_BOT_TOKEN=   # uncomment to wire the optional Telegram gateway (System B)
