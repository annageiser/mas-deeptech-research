# Caddy reverse proxy for the BSc-thesis site.
#
# Automatic HTTPS via Let's Encrypt for the domain below. Caddy obtains and
# renews the certificate with zero config beyond this file.
#
# Routing (FastAPI + Next.js stack):
#   /api/*  → api  (FastAPI JSON service, container `api-container-f`)
#   /*      → web  (Next.js frontend,     container `web-container-g`)
#
# Post-thesis (v0.5.6, 2026-08-07): the site is public read-only. Basic auth
# was removed; write endpoints and their UI were removed from api and web.
# Producer containers (masfactory, hermes, reports) are stopped and their
# cron files disabled on the host.
#
# ALWAYS use `docker compose restart caddy` after editing this file (in-memory
# config is sticky from container start time; caddy reload does not apply
# changes reliably).

mas-deeptech-research.cloud {
    encode gzip

    handle /api/* {
        reverse_proxy api-container-f:8000
    }

    handle {
        reverse_proxy web-container-g:3000
    }
}

www.mas-deeptech-research.cloud {
    redir https://mas-deeptech-research.cloud{uri} permanent
}
