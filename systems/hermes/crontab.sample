# Host-side crontab entry for System B (Hermes).
#
# Install on the Hostinger VPS host (NOT inside the container) with:
#   sudo cp systems/hermes/crontab.sample /etc/cron.d/hermes
#   sudo chmod 0644 /etc/cron.d/hermes
#   sudo systemctl restart cron
#
# Daily at 05:00 UTC (3 hours after System A so they don't compete for
# arXiv / the same actor websites). Scrape, then daily report.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ=Europe/Zurich

# m h dom mon dow user  command
0 5 * * *   root   cd /opt/mas-deeptech-research && /usr/bin/docker compose run --rm hermes run-once >> /var/log/hermes.log 2>&1 && /usr/bin/docker compose run --rm reports daily --system hermes >> /var/log/reports.log 2>&1
